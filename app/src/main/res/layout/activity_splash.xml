<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Not flattened into the RelativeLayout: this centers the icon+slogan
         as one group (layout_centerInParent on the pair). Moving the children
         up a level would center the ImageView alone instead, shifting the
         pair's apparent vertical center — a visible change on the first
         screen users see, for a one-off, lightweight layout. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="40dp"
        tools:ignore="UselessParent">

        <!-- Not collapsed into a single TextView with a compound drawable:
             XML drawableTop always sizes to the drawable's intrinsic size,
             with no way to pin it to exactly 108dp the way layout_width/height
             does here, and this is the first screen users see — not worth the
             branding risk for one fewer view. -->
        <ImageView
            android:layout_width="108dp"
            android:layout_height="108dp"
            android:contentDescription="@null"
            android:src="@mipmap/ic_launcher_foreground"
            tools:ignore="UseCompoundDrawables" />

        <TextView
            android:id="@+id/label_slogan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginStart="48dp"
            android:layout_marginEnd="48dp"
            android:alpha="0.88"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="18sp" />

    </LinearLayout>

</RelativeLayout>
