<?xml version="1.0" encoding="utf-8"?>
<!-- Debug manifest overlay -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Already confined to this debug-only manifest, which is the correct
         place per lint's own guidance; suppressed since there's nothing to fix. -->
    <uses-permission
        android:name="android.permission.ACCESS_MOCK_LOCATION"
        tools:ignore="MockLocation" />

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:networkSecurityConfig">

        <!-- Debug-only: inject GPS via adb broadcast (see MockLocationReceiver).
             Exported and unprotected by design — it exists so
             `adb shell am broadcast` can reach it from outside the app, and
             this manifest never ships in a release build. -->
        <receiver
            android:name=".debug.MockLocationReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="org.github.nynosy.adiresy_mobile.MOCK_LOCATION" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
